# URL del backend NestJS. El frontend lo consume desde el server
# (server components) y desde el cliente (no aplica, sólo usamos
# router.push en SearchForm). NEXT_PUBLIC_ lo embebe en el bundle
# del cliente, así que queda público — está bien porque el endpoint
# no requiere auth.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Username que la home (`/`) renderiza por default. Si el backend
# devuelve 404 para este user, la home dispara notFound() y se
# renderiza not-found.tsx. Cambialo a tu usuario o a cualquier
# perfil público de GitHub que quieras que aparezca al entrar.
NEXT_PUBLIC_DEFAULT_USERNAME=LEIZ3R
